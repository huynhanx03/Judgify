# Local process configuration. Copy to `api/.env`; never commit the copy.
GO_ENV=local
JUDGIFY_VERSION=development

# Keep these values aligned with the repository-root `.env` used by Compose.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=judgify_dev
DATABASE_PASSWORD=replace-with-the-same-local-random-password
DATABASE_DATABASE=judgify

# Generate a unique value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Real provider credentials are required only when exercising the corresponding
# OAuth or email journey. These local placeholders let unrelated flows start.
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
GITHUB_CLIENT_ID=local-github-client-id
GITHUB_CLIENT_SECRET=local-github-client-secret

# Resend API
RESEND_API_KEY=local-resend-placeholder
RESEND_FROM_EMAIL=security@localhost.invalid
RESEND_FROM_NAME=Judgify
RESEND_RESET_URL=http://localhost:3000/reset-password
RESEND_VERIFICATION_URL=http://localhost:3000/verify-recovery-contact
RESEND_INVITATION_URL=http://localhost:3000/accept-invitation
