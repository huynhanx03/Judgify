{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "npm run check:architecture && eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public.spec.ts e2e/theme-responsive.spec.ts",
    "test:e2e:member": "playwright test e2e/member.spec.ts",
    "test:e2e:admin": "playwright test e2e/admin.spec.ts",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts",
    "test:e2e:release": "JUDGIFY_E2E_REQUIRE_FULL=1 JUDGIFY_E2E_ENFORCE_PERFORMANCE=1 JUDGIFY_E2E_SERVER_COMMAND='npm run start' playwright test",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "check:routes": "node scripts/check-routes.mjs && node scripts/check-thin-routes.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:user-role-contract": "node scripts/check-user-role-assignment-contract.mjs",
    "test:realtime": "npm run test:contracts",
    "check:architecture:inventory": "node scripts/check-frontend-architecture.mjs --print-inventory",
    "verify": "npm run lint && npm run check:routes && npm run check:user-role-contract && npm run test:contracts && npm run test && npm run typecheck",
    "verify:release": "npm run verify && npm run build && npm run check:bundle && npm run test:e2e:release"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "katex": "0.16.44",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "shadcn": "4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.13.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
