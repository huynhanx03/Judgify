meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/ranks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Bronze",
    "min_rating": 0,
    "description": "Starting rank for all cultivators"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("rank_id", res.body.data.id);
  }
}
