meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/elements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Fire",
    "code": "fire",
    "description": "Explosive power, core algorithms"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("element_id", res.body.data.id);
  }
}
