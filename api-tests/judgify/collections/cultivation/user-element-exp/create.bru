meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/user-element-exps
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "user_id": 1,
    "element_id": 1,
    "exp": 0
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("user_element_exp_id", res.body.data.id);
  }
}
