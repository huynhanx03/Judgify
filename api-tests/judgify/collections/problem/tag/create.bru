meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "array"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("tag_id", res.body.data.id);
  }
}
