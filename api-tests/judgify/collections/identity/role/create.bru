meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "editor",
    "description": "Editor role"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("role_id", res.body.data.id);
  }
}
