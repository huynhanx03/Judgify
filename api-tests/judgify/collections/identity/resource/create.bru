meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "key": "problem",
    "description": "Problem resource"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("resource_id", res.body.data.id);
  }
}
