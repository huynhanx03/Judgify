meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{base_url}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "role_id": 1,
    "resource_id": 1,
    "scope": 15
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("permission_id", res.body.data.id);
  }
}
